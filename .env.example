# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Copy this from Supabase Dashboard → Connect → ORM → Drizzle
# Example: postgresql://postgres.abcd1234:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Creem API Configuration
CREEM_API_KEY=
# Site Configuration
NEXT_PUBLIC_SITE_URL=
# Creem WebHook Configuration
# Get this from Creem Dashboard > Developers > Webhooks
CREEM_WEBHOOK_SECRET=
# Creem URL
NEXT_PUBLIC_CREEM_URL=

